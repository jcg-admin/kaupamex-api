# kaupamex.service — servidor de aplicación del producto L0.
#
# Adaptación de `odoo19c: debian/odoo.service` (odoo-tools@abe4040). La
# referencia arranca `/usr/bin/odoo` con Type=simple y sin supervisor
# intermedio; el binario ES el proceso de la aplicación. Aquí el binario es
# `kaupamex-bin server`, que delega en Gunicorn por ADR-027 — el servidor
# viaja dentro del producto, no lo provee la máquina destino.
#
# DIVERGENCIA DECLARADA — la referencia lleva UNA unidad, nosotros DOS.
# Su cron vive dentro del binario: `cron_spawn()` lanza hilos en
# ThreadedServer (`odoo/service/server.py:614-624,723`) y `WorkerCron` es un
# proceso del arbiter en PreforkServer (`:1047`). El pool HTTP de Gunicorn es
# homogéneo —una única `worker_class` atada a LISTENERS,
# `gunicorn/arbiter.py:687-691`, y sus seis clases son todas HTTP— así que el
# cron no puede ser un worker más del pool.
#
# Lo que NO es cierto es que Gunicorn "no pueda alojarlo": sus hooks
# `on_starting` (`arbiter.py:162`) y `when_ready` (`arbiter.py:199`) corren en
# el master y desde ahí se puede forkear un proceso lateral. Medido con
# `scripts/probe_gunicorn_side_process.py` (Gunicorn 26.0.0): el hijo arranca
# y late, pero SOBREVIVE al SIGTERM del master (17 latidos posteriores). Ese
# huérfano es el motivo real de la segunda unidad — systemd daría ésta por
# detenida con el cron todavía tocando la base, y el `KillMode=mixed` de abajo
# señala al líder del cgroup, no a un reparentado. Ver `kaupamex-cron.service`.
#
# Instalación (el operador ajusta rutas y usuario):
#
#   sudo cp setup/kaupamex.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kaupamex
#
# NO se instala solo: no hay receta de paquete todavía. La referencia sí la
# tiene (`debian/rules` + `debian/install`), y ésa es la diferencia real de
# madurez entre su cadena de despliegue y la nuestra.

[Unit]
Description=Kaupamex L0 — servidor de aplicacion (Gunicorn)
Documentation=https://github.com/jcg-admin/kaupamex-api
# PostgreSQL es precondición dura: sin base, los workers arrancan y fallan en
# la primera petición. `Wants` y no `Requires` — si la base cae después, el
# reinicio lo maneja Restart, no una dependencia que tumbe la unidad.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=kaupamex
Group=kaupamex
WorkingDirectory=/opt/kaupamex/api

# El binario resuelve `src/` por sí mismo (`kaupamex-bin:25`), así que NO se
# arma PYTHONPATH a mano — ver H-API-385, donde el que había apuntaba a
# `kaupamex/`, un directorio que dejó de existir con el rename a `src/`.
#
# Se invoca el intérprete del venv EXPLÍCITAMENTE: el shebang de kaupamex-bin
# es `#!/usr/bin/env python3` y resolvería al Python del sistema, sin las
# dependencias. Mismo motivo por el que `scripts/bootstrap.sh:253` lo hace así.
ExecStart=/opt/kaupamex/api/.venv/bin/python /opt/kaupamex/api/kaupamex-bin server

# PATH es OBLIGATORIO, no cosmético. El subcomando termina en
# `os.execvp('gunicorn', argv)` (`management/commands/server.py:58`), y execvp
# busca en PATH. Medido: `env -i .venv/bin/python -c "print(os.environ.get('PATH'))"`
# imprime vacío — invocar el intérprete del venv NO añade su `bin/` al PATH
# (eso lo hace `activate`, que aquí no corre). Sin esta línea la unidad falla
# al arrancar con FileNotFoundError, no con un error de configuración.
Environment=PATH=/opt/kaupamex/api/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DJANGO_SETTINGS_MODULE=config.settings.production

# 12-factor: toda la configuración vive en `.env` (settings/base.py:281).
# systemd lee KEY=value y respeta comentarios; NO admite `export` ni
# sustitución de variables — si el `.env` los usa, esta línea no basta.
EnvironmentFile=/opt/kaupamex/api/src/.env

# KillMode=mixed viene de la referencia verbatim: SIGTERM sólo al proceso
# principal —el master de Gunicorn, que drena sus workers— y SIGKILL al grupo
# si vence el plazo. Por eso el subcomando usa execvp en vez de envolver a
# Gunicorn (`server.py:16-19`): sin padre Python intermedio, la señal de
# systemd llega al master directamente.
KillMode=mixed
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
