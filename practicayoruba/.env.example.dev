# =============================================================================
# .env.example.dev — PracticaYoruba-api (desarrollo local / WSL2)
# =============================================================================
# Copia este archivo a practicayoruba/.env cuando trabajes en WSL2 o
# en un entorno de desarrollo local. Tiene los paths adaptados al layout
# de desarrollo (/srv/repos/ecom/) en lugar del layout de producción
# OVHCloud (/opt/practicayoruba/).
#
#   cp practicayoruba/.env.example.dev practicayoruba/.env
#
# Para producción OVHCloud usar .env.example en su lugar.
#
# El archivo practicayoruba/.env está en .gitignore — nunca lo subas
# al repositorio.
#
# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
# SECRET_KEY: generar uno real con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS
DEBUG=True
# En desarrollo local (runserver): solo localhost es necesario.
ALLOWED_HOSTS=practicayoruba.mx,localhost,127.0.0.1

# ─── Base de datos — produccion / desarrollo ─────────────────────────────────
# Las variables coinciden con las de db/.env (mismo schema, mismo usuario).
DB_NAME=practicayoruba_db
DB_USER=django_user
DB_PASSWORD=django_pass
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Base de datos — QA (Unit Testing / Acceptance) ──────────────────────────
# NUNCA apuntar a produccion. pytest-django escribe y borra datos.
DB_QA_NAME=practicayoruba_qa
DB_QA_USER=django_user
DB_QA_PASSWORD=django_pass
DB_QA_HOST=127.0.0.1
DB_QA_PORT=3306

# ─── Media (uploads de usuario) ─────────────────────────────────────────────
# Path WSL2/dev: dentro del layout /srv/repos/ecom/. En producción
# OVHCloud usar /opt/practicayoruba/media (ver .env.example).
MEDIA_ROOT=/srv/data/practicayoruba/media/
# En desarrollo local (runserver) el default de base.py es suficiente;
# solo se necesita esta variable si se quiere sobreescribir la ruta.

# ─── SPA (React UI build) ────────────────────────────────────────────────────
# Path WSL2/dev al build del UI. En producción OVHCloud usar
# /opt/practicayoruba/ui/dist (ver .env.example).
UI_DIST=/srv/repos/ecom/e-commerce-ui/dist

# ─── Seed de usuarios E2E ────────────────────────────────────────────────────
# Usado por: python manage.py create_seed_users
# Invocado automaticamente por bootstrap.sh si estas variables estan definidas.
# Generado por init-env.sh si no existen (openssl rand -hex 16).
ADMIN_EMAIL=admin@practicayoruba.mx
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-THIS
QA_BUYER_EMAIL=qabuyer@practicayoruba.mx
QA_BUYER_PASSWORD=CHANGE-THIS

# ─── Seed de catálogo E2E ─────────────────────────────────────────────────────
# Usado por: python manage.py create_seed_catalog
# Invocado automaticamente por bootstrap.sh tras create_seed_users.
# No requiere variables de entorno adicionales — datos hardcodeados
# con defaults QA razonables (SKU=QA-001, price=100.00, stock=5).
