# =============================================================================
# .env.example — PracticaYoruba-api (Django backend)
# =============================================================================
# Copia este archivo a practicayoruba/.env y completa los valores
# reales antes de ejecutar bootstrap.sh o pytest.
#
#   cp practicayoruba/.env.example practicayoruba/.env
#
# El archivo practicayoruba/.env está en .gitignore — nunca lo subas
# al repositorio.
#
# Los defaults son seguros para desarrollo local (loopback + password
# de demo). En produccion (WSL2 simulando VPS o VPS real) hay que
# rotar SECRET_KEY y DB_PASSWORD / DB_QA_PASSWORD.
#
# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
# SECRET_KEY: generar uno real con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Base de datos — produccion / desarrollo ─────────────────────────────────
# Las variables coinciden con las de db/.env (mismo schema, mismo usuario).
DB_NAME=practicayoruba_db
DB_USER=django_user
DB_PASSWORD=django_pass
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Base de datos — QA (Unit Testing / Acceptance) ──────────────────────────
# NUNCA apuntar a produccion. pytest-django escribe y borra datos.
# Variables consumidas por scripts/provisioners/mysql/db_qa_setup.sh.
DB_QA_NAME=practicayoruba_qa
DB_QA_USER=django_user
DB_QA_PASSWORD=django_pass
DB_QA_HOST=127.0.0.1
DB_QA_PORT=3306
