# =============================================================================
# .env.example — PracticaYoruba-api (Django backend)
# =============================================================================
# Copia este archivo a practicayoruba/.env y completa los valores
# reales antes de ejecutar bootstrap.sh o pytest.
#
#   cp practicayoruba/.env.example practicayoruba/.env
#
# El archivo practicayoruba/.env está en .gitignore — nunca lo subas
# al repositorio.
#
# Los defaults son seguros para desarrollo local (loopback + password
# de demo). En produccion (WSL2 simulando VPS o VPS real) hay que
# rotar SECRET_KEY y DB_PASSWORD / DB_QA_PASSWORD.
#
# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
# SECRET_KEY: generar uno real con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS
DEBUG=True
# En produccion con Apache: incluir el dominio publico.
# En desarrollo local (runserver): solo localhost es necesario.
ALLOWED_HOSTS=practicayoruba.com,www.practicayoruba.com,localhost,127.0.0.1

# ─── Base de datos — produccion / desarrollo ─────────────────────────────────
# Las variables coinciden con las de db/.env (mismo schema, mismo usuario).
DB_NAME=kaupamex_db
DB_USER=kaupamex_app
DB_PASSWORD=
DB_HOST=db.kaupamex.com
DB_PORT=3306
# SSL siempre activo via certifi (bundle CAs publico — valido para Let's Encrypt).
# Para dev local con socket Unix, sobreescribir HOST y setear DB_SOCKET:
#   DB_HOST=127.0.0.1  DB_SOCKET=/run/mysqld/mysqld.sock
DB_SOCKET=

# ─── Base de datos — QA (Unit Testing / Acceptance) ──────────────────────────
# NUNCA apuntar a produccion. pytest-django escribe y borra datos.
# Variables consumidas por e-commerce-db/provisioners/mariadb/db_qa_setup.sh.
DB_QA_NAME=kaupamex_qa
DB_QA_USER=kaupamex_app
DB_QA_PASSWORD=
DB_QA_HOST=db.kaupamex.com
DB_QA_PORT=3306
# SSL siempre activo via certifi. Para dev local con socket Unix:
#   DB_QA_HOST=127.0.0.1  DB_QA_SOCKET=/run/mysqld/mysqld.sock
DB_QA_SOCKET=

# ─── Media (uploads de usuario) ─────────────────────────────────────────────
# Iniciativa: agregar-fotos-reviews (RF-2).
# DEBE apuntar fuera del árbol del repo api. MEDIA_ROOT por defecto en
# base.py es BASE_DIR/'media' = practicayoruba/media/ (Clase A — código).
# Si el deploy hace checkout/rebuild limpio, esa ruta se borra con el repo.
# En producción mover a un path fuera del repo (clase de datos primarios
# de usuario — Clase A/B/C de D-030 no aplican; requiere nueva clase):
MEDIA_ROOT=/opt/practicayoruba/media
# En desarrollo local (runserver) el default de base.py es suficiente;
# solo se necesita esta variable si se quiere sobreescribir la ruta.

# ─── SPA (React UI build) ────────────────────────────────────────────────────
# Iniciativa: configurar-ui-dist-en-deploy (H-UID-1, H-UID-2).
# Path al build del UI (output de 'npm run build' en e-commerce-ui).
# Si esta vacio, serve_spa NO se registra en urls.py y la SPA debe
# servirse desde otra fuente (CDN, VPS aparte, o un AliasMatch en
# Apache apuntando directo al dist/).
#
# Valor canónico en OVHCloud (producción). Para desarrollo local WSL2
# copiar .env.example.dev que tiene el path adaptado al layout local:
UI_DIST=/opt/practicayoruba/ui/dist

# ─── Seed de usuarios E2E ────────────────────────────────────────────────────
# Usado por: python manage.py create_seed_users
# Invocado automaticamente por bootstrap.sh si estas variables estan definidas.
# Generado por init-env.sh si no existen (openssl rand -hex 16).
# En produccion real, rotar a credenciales seguras propias.
# El archivo .env esta en .gitignore — nunca subir passwords al repo.
ADMIN_EMAIL=admin@practicayoruba.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-THIS
QA_BUYER_EMAIL=qabuyer@practicayoruba.com
QA_BUYER_PASSWORD=CHANGE-THIS

# ─── Seed de catálogo E2E ─────────────────────────────────────────────────────
# Usado por: python manage.py create_seed_catalog
# Invocado automaticamente por bootstrap.sh tras create_seed_users.
# No requiere variables de entorno adicionales — datos hardcodeados
# con defaults QA razonables (SKU=QA-001, price=100.00, stock=5).
# Para invocar manualmente:
#   cd practicayoruba && python manage.py create_seed_catalog
#   python manage.py create_seed_catalog --dry-run  # (sin escritura en BD)

# ─── MercadoPago — sandbox (TEST) credentials ────────────────────────────────
# Credenciales de sandbox para development/QA.
# Obtenidas desde el panel de developers.mercadopago.com (Mis credenciales > Test).
# Usadas por: manage.py setup_mp_gateway y fixtures mp_gateway_activo / mp_gateway.
# En producción reemplazar por las credenciales live y agregar MP_ACCESS_TOKEN / MP_PUBLIC_KEY.
MP_TEST_ACCESS_TOKEN=TEST-CHANGE-THIS
MP_TEST_PUBLIC_KEY=TEST-CHANGE-THIS

# ─── MercadoPago — usuarios de prueba (sandbox) ──────────────────────────────
# Generados en developers.mercadopago.com > Usuarios de prueba.
# MP_TEST_BUYER_USER / MP_TEST_BUYER_PASS → usuario comprador para simular pagos.
# MP_TEST_SELLER_USER / MP_TEST_SELLER_PASS → usuario vendedor (receptor).
# Sólo necesarios para tests E2E que interactúan con la UI del checkout.
MP_TEST_BUYER_USER=CHANGE-THIS
MP_TEST_BUYER_PASS=CHANGE-THIS
MP_TEST_SELLER_USER=CHANGE-THIS
MP_TEST_SELLER_PASS=CHANGE-THIS

# ─── MercadoPago — tarjetas de prueba (sandbox, público) ─────────────────────
# Valores fijos de sandbox MercadoPago México. No son secretos — son públicos.
# Para simular el resultado del pago usar el nombre del titular:
#   APRO → aprobado | CONT → pendiente | FUND → sin fondos
#   SECU → CVV inválido | EXPI → fecha vencida | FORM → error de formulario
#   CALL → requiere autorización | OTHE → error general
#
# Mastercard crédito: 5474 9254 3267 0366  CVV 123   11/30
# Visa crédito:       4075 5957 1648 3764  CVV 123   11/30
# Mastercard débito:  5579 0534 6148 2647  CVV 1234  11/30
# Visa débito:        4189 1412 2126 7633  CVV 123   11/30
