<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptado de `app_auto_backup/security/user_groups.xml`
    (odoo-tools: 18.x/app-odoo-18.0, LGPL-3; atribución y aviso de licencia
    preservados, DEC-KX-03). Dos divergencias de mecanismo, por la base 19:

    1. El módulo se llama `auto_backup`: las referencias
       `app_auto_backup.<id>` de la fuente se escriben sin prefijo.
    2. `res.groups.category_id` no existe en la base 19. El grupo se liga a
       su categoría por un `res.groups.privilege`, como
       `odoo19c: addons/account/security/account_security.xml:40-44,59`.

    Diseño: scripts/workbench/orm-continuation-plan-20261103T095630/designs/
    basemodel-adoption-auto-backup.md
-->
<odoo>
    <data>
        <record model="ir.module.category" id="module_management">
            <field name="name">Auto backup access</field>
            <field name="description">User access level for this module</field>
            <field name="sequence">3</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_auto_backup">
            <field name="name">Auto backup access</field>
            <field name="category_id" ref="module_management"/>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_auto_backup"/>
        </record>
        <!-- group_system: los usuarios de sistema son gestores de respaldo. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
        </record>
    </data>
</odoo>
