+class TestMoveUnlink:
+    """≙ ``unlink`` de ``account.move``
+    (``odoo19c: addons/account/models/account_move.py:4055``)."""
+
+    def test_move_unlink_removes_lines_and_partials(self, company, journal):
+        debit = _line(company, journal, debit=Decimal('65.00'))
+        credit = _line(company, journal, credit=Decimal('65.00'))
+        partial = AccountPartialReconcile.create_partial(
+            debit, credit, Decimal('65.00')
+        )
+        move = debit.move
+
+        move.unlink()
+
+        assert not AccountMove.objects.filter(pk=move.pk).exists()
+        assert not AccountMoveLine.objects.filter(pk=debit.pk).exists()
+        assert not _partials(partial.pk).exists()
+        credit.refresh_from_db()
+        assert credit.matching_number == ''
+
+    def test_move_unlink_without_reconciliation(self, company, journal):
+        line = _line(company, journal, debit=Decimal('5.00'))
+        move = line.move
+
+        move.unlink()
+
+        assert not AccountMove.objects.filter(pk=move.pk).exists()
+        assert not AccountMoveLine.objects.filter(pk=line.pk).exists()
+
+    def test_empty_recordset_is_a_no_op(self):
+        assert env()['account.move'].browse().unlink() is True
